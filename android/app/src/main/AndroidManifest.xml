<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════════
         1. PERMISOS REQUERIDOS PARA RED Y PUBLICIDAD
         ═══════════════════════════════════════════════════════════════════ -->
    <!-- [LOG] Permite a la app conectarse a Internet (PocketBase, AdMob, Firebase) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    
    <!-- [LOG] Permite detectar si el usuario está offline para evitar errores de red -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    
    <!-- [LOG] Permiso obligatorio para AdMob (Identificador de Publicidad estándar) -->
    <uses-permission android:name="android.permission.AD_ID"/>
    
    <!-- [LOG][CRÍTICO] Permiso explícito para Google Play Services (Soluciona la advertencia de Play Console) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="merge"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         2. VISIBILIDAD DE PAQUETES (Android 11+ / API 30+)
         ═══════════════════════════════════════════════════════════════════ -->
    <!-- [LOG] Necesario para que url_launcher y flutter_custom_tabs puedan abrir enlaces externos -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- [LOG] Añadido soporte para lanzar la app de Google Play Store -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:label="Videitos"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">
        <!-- ⚠️ [SEGURIDAD] 
             usesCleartextTraffic="false": Bloquea todo tráfico HTTP (obliga a usar HTTPS).
             allowBackup="false": Evita que se extraiga la base de datos o tokens de sesión vía ADB.
             enableOnBackInvokedCallback="true": Habilita el gesto de "atrás" predictivo en Android 13+. -->
        
        <!-- ═══════════════════════════════════════════════════════════════
             3. ADMOB APP ID Y GOOGLE PLAY SERVICES
             ═══════════════════════════════════════════════════════════════ -->
        <!-- [LOG] ID de aplicación de AdMob (Producción) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9211240922699669~5270550616"/> 

        <!-- [LOG] Requerido por Firebase y AdMob para verificar la versión de GMS -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- ═══════════════════════════════════════════════════════════════
             4. ACTIVIDAD PRINCIPAL (FLUTTER ENGINE)
             ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            
            <!-- [LOG] Mantiene el tema oscuro nativo durante el arranque (evita flash blanco) -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
            />
              
            <!-- [LOG] Filtro para abrir la app normalmente desde el ícono -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ═══════════════════════════════════════════════════════════
                 [LOG][CRÍTICO] FILTRO PARA OAuth2 (Google / Apple Login)
                 Este filtro permite que la app capture la redirección
                 que viene desde Google (a través de PocketBase) y cierre
                 el navegador para volver a la app.
                 ═══════════════════════════════════════════════════════════ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                
                <!-- [LOG] El esquema debe coincidir exactamente con el package ID / Bundle ID.
                     En este caso usamos "cl.videitos.app" y el host "auth-callback" -->
                <data android:scheme="cl.videitos.app" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- ═══════════════════════════════════════════════════════════════
             5. METADATOS DEL MOTOR FLUTTER
             ═══════════════════════════════════════════════════════════════ -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
            
    </application>

</manifest>